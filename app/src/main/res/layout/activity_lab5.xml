<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".Lab5Activity">

    <!-- Mėlyna antraštė -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#3F51B5"
        android:padding="16dp"
        android:text="LAB 5 – Fragmentai"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- 1 fragmentas: sąrašas – užima visą likusią vietą -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/sarasoKonteineris"
        android:name="com.example.labwork.SarasoFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 2 arba 3 fragmentas: tik tiek aukščio, kiek reikia tekstui -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/detaliuKonteineris"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>